<h2><%= @user.name %></h2>

<h3>Upcoming events</h3>
<h4>Private</h4>
<ul>
  <% @user.attended_events.private_visibility.upcoming.each do |event| %>
    <%= render partial: "partials/event_listing", locals: { event: event } %>
  <% end %>
</ul>

<h4>Public</h4>
<ul>
  <% @user.attended_events.public_visibility.upcoming.each do |event| %>
    <%= render partial: "partials/event_listing", locals: { event: event } %>
  <% end %>
</ul>

<h3>Past events</h3>
<h4>Private</h4>
<ul>
  <% @user.attended_events.private_visibility.past.each do |event| %>
    <%= render partial: "partials/event_listing", locals: { event: event } %>
  <% end %>
</ul>

<h4>Public</h4>
<ul>
  <% @user.attended_events.public_visibility.past.each do |event| %>
    <%= render partial: "partials/event_listing", locals: { event: event } %>
  <% end %>
</ul>