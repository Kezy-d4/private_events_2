<h2><%= @user.name %></h2>

<ul>
  <% @user.events_involving_user.each do |event_involving_user| %>
    <li>
      <%=  
        link_to(
          "#{event_involving_user.title} by #{event_involving_user.creator.name}",
          event_path(event_involving_user)
        )
      %>
    </li>
  <% end %>
</ul>