<h2><%= @user.name %></h2>

<h3>Upcoming events</h3>
<ul>
  <% @user.attended_events.public_visibility.upcoming.each do |e| %>
    <li><%= link_to "#{e.title} by #{e.creator.name}", event_path(e) %></li>
  <% end %>

  <% @user.attended_events.private_visibility.upcoming.each do |e| %>
    <% if user_signed_in? && e.attended_by_user?(current_user.id) %>
      <li><%= link_to "#{e.title} by #{e.creator.name}", event_path(e) %></li>
    <% end %>
  <% end %>
</ul>

<h3>Past events</h3>
<ul>
  <% @user.attended_events.public_visibility.past.each do |e| %>
    <li><%= link_to "#{e.title} by #{e.creator.name}", event_path(e) %></li>
  <% end %>

  <% @user.attended_events.private_visibility.past.each do |e| %>
    <% if user_signed_in? && e.attended_by_user?(current_user.id) %>
      <li><%= link_to "#{e.title} by #{e.creator.name}", event_path(e) %></li>
    <% end %>
  <% end %>
</ul>