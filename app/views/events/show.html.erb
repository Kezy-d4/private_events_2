<%# TITLE %>
<h2><%= @event.title %> hosted by <%= @event.creator.name %></h2>

<%# EVENT MANAGEMENT %>
<section>
  <h3>Manage</h3>
  <ul>
    <% if @event.created_by_user?(current_user) %>
      <li><%= link_to "Edit event", edit_event_path(@event) %></li>
      <li>
        <%=
          button_to(
            "Delete event",
             event_path(@event), 
             method: :delete,
             data: { turbo_confirm: "Are you sure?" } 
          )
        %>
      </li>
    <% end %>

    <% unless @event.created_by_user?(current_user) %>
      <li>
        <%=
          render(
            partial: "partials/event_attendance_form", 
            locals: { event: @event, user: current_user }
          )
        %>
      </li>
    <% end %>
  </ul>
</section>

<%# TAGS %>
<section>
  <h3>Tags</h3>
  <ul>
    <% if @event.created_by_user?(current_user) %>
      <li>Host</li>
    <% elsif @event.attended_by_user?(current_user) %>
      <li>Attendee</li>
    <% end %>

    <% if @event.private %>
      <li>Private</li>
    <% else %>
      <li>Public</li>
    <% end %>
  </ul>
</section>

<%# EVENT ATTENDEES %>
<section>
  <h3>Event attendees</h3>
  <ul>
    <% @event.event_attendees.each do |event_attendee| %>
      <li><%= event_attendee.name %></li>
    <% end %>
  </ul>
</section>

<%# INVITE USERS %>
<% if @event.created_by_user?(current_user) %>
  <section>
    <h3>Invite users</h3>
    <ul>
      <% User.all_except(current_user).each do |user| %>
        <% unless @event.attended_by_user?(user) %>
          <li>
            <p>
              <p><%= user.name %></p>
              <%=
                render(
                  partial: "partials/event_invitation_form",
                  locals: { event: @event, user: user }
                )
              %>
            </p>
          </li>
        <% end %>
      <% end %>
    </ul>
  </section>
<% end %>

<%# EVENT INFO %>
<section>
  <h3>Details</h3>
  <ul>
    <li><%= "Host: #{@event.creator.name}" %></li>
    <li><%= "Location: #{@event.location}" %></li>
    <li><%= "Start date and time: #{@event.start_date_and_time}" %></li>
    <li><%= "Description: #{@event.description}" %></li>
  </ul>
</section>
