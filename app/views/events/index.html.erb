<h2>Browse events</h2>

<h3>Upcoming events</h3>
<ul>
  <% Event.public_visibility.upcoming.each do |e| %>
    <%= render partial: "event_listing", locals: { e: e } %>
  <% end %>

  <% Event.private_visibility.upcoming.each do |e| %>
    <% if user_signed_in? && e.involves_user?(current_user) %>
      <%= render partial: "event_listing", locals: { e: e } %>
    <% end %>
  <% end %>
</ul>

<h3>Past events</h3>
<ul>
  <% Event.public_visibility.past.each do |e| %>
    <%= render partial: "event_listing", locals: { e: e } %>
  <% end %>

  <% Event.private_visibility.past.each do |e| %>
    <% if user_signed_in? && e.involves_user?(current_user) %>
      <%= render partial: "event_listing", locals: { e: e } %>
    <% end %>
  <% end %>
</ul>