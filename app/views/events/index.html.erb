<h2>Browse events</h2>

<h3>Upcoming events</h3>
<h4>Private</h4>
<ul>
  <% Event.private_visibility.upcoming.each do |event| %>
    <% if event.attended_by_user?(current_user) %>
      <%= render partial: "partials/event_listing", locals: { event: event } %>
    <% end %>
  <% end %>
</ul>

<h4>Public</h4>
<ul>
  <% Event.public_visibility.upcoming.each do |event| %>
    <%= render partial: "partials/event_listing", locals: { event: event } %>
  <% end %>
</ul>

<h3>Past events</h3>
<h4>Private</h4>
<ul>
  <% Event.private_visibility.past.each do |event| %>
    <% if event.attended_by_user?(current_user) %>
      <%= render partial: "partials/event_listing", locals: { event: event } %>
    <% end %>
  <% end %>  
</ul>

<h4>Public</h4>
<ul>
  <% Event.public_visibility.past.each do |event| %>
    <%= render partial: "partials/event_listing", locals: { event: event } %>
  <% end %>
</ul>