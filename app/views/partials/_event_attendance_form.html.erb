<% if event.created_by_user?(user) %>

<% elsif event.attended_by_user?(user) %>
  <%= 
    form_with(
      url: event_attendance_path(user.event_attendances.find_by_attended_event_id(event.id)),
      method: "delete"
    ) do |form|
  %>
    <%= form.submit "Revoke attendance" %>
  <% end %>

<% elsif !event.involves_user?(user) %>
  <%= form_with url: event_attendances_path, scope: :event_attendance do |form| %>
    <%= form.hidden_field :event_attendee_id, value: user.id %>
    <%= form.hidden_field :attended_event_id, value: event.id %>
    <%= form.submit "Attend event" %>
  <% end %>
<% end %>